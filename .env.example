# Copy to .env and choose your own passwords.
# SQL Server requires at least 8 characters from three of: upper case, lower case, digits, symbols.
# Avoid single quotes, the passwords end up in SQL statements during the first start.

MSSQL_SA_PASSWORD=Change_Me_2026!
POSTGRES_PASSWORD=Change_Me_2026!

# Read-only account the backends use. It sees the analytics views and nothing else.
ANALYTICS_READER_PASSWORD=Reader_Change_Me_2026!

# Which sales territory group the backends may see: * for all, or Europe, North America, Pacific.
DATA_SCOPE=*
