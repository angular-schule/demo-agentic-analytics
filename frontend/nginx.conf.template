# Serves the Angular app and forwards the two APIs, so the browser talks to one origin only.
# The nginx image fills in ${AGENT_URL} when the container starts.
server {
  listen 80;
  root /usr/share/nginx/html;

  # The bundle and the JSON answers compress well; event streams stay uncompressed (not listed).
  gzip on;
  gzip_types application/javascript text/css application/json image/svg+xml;

  # Docker's DNS, asked at request time: the backends may start later or restart.
  resolver 127.0.0.11 valid=10s;
  set $data_api http://data-api:8080;
  set $agent ${AGENT_URL};

  location ^~ /api/ {
    proxy_pass $data_api;
  }

  location ^~ /agent/ {
    proxy_pass $agent;
    # AG-UI streams server-sent events; they must reach the browser as they come.
    proxy_buffering off;
    proxy_read_timeout 300s;
  }

  # File names carry a content hash, so they never change.
  location ~* \.(js|css)$ {
    expires 1y;
    add_header Cache-Control immutable;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
