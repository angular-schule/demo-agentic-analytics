# The demo model: no LLM, but keyword matching against the data model (demo-model/demo.mjs).
# Compose loads this file first and agent/.env after it, so agent/.env with a real model wins.
# The demo model answers in OpenAI's formats, so every agent reaches it as an OpenAI model.
MODEL=openai/demo-no-llm
OPENAI_API_KEY=demo
OPENAI_BASE_URL=http://demo-model:4000/v1
