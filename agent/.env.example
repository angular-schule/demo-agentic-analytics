# The agent's model, wherever the agent runs: in the backend or as this separate service.
# Model as provider/model. The matching API key below must be set.
# Every backend supports all four providers.
MODEL=anthropic/claude-sonnet-5-5
# MODEL=openai/gpt-5.6-terra
# MODEL=google/gemini-3-flash-preview
# MODEL=mistral/mistral-large-latest
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Processing in the EU (storage and inference), a contract option of OpenAI:
# OPENAI_BASE_URL=https://eu.api.openai.com/v1
# GOOGLE_GENERATIVE_AI_API_KEY=
# MISTRAL_API_KEY=
# Processing in the EU with Mistral:
# MISTRAL_BASE_URL=https://api.eu.mistral.ai/v1

# DEBUG ONLY: the traffic window in the app shows every prompt, tool result and answer.
# It is on by default for learning; switch it off for anything beyond a local demo.
# DEBUG_TRAFFIC=off

# Only for the separate agent service: the backend, .NET (8081) or Node (8082), same contract.
DATA_API_URL=http://127.0.0.1:8081
